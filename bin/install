#!/usr/bin/env bash
#
# Copies the downloaded dafny release into $ASDF_INSTALL_PATH/bin, preserving
# the layout dafny expects (its bundled z3 binary is found via a path
# relative to the dafny executable).

set -euo pipefail

fail() {
  echo -e "asdf-dafny: $*" >&2
  exit 1
}

[ -n "${ASDF_INSTALL_TYPE:-}" ] || fail "missing ASDF_INSTALL_TYPE"
[ -n "${ASDF_INSTALL_PATH:-}" ] || fail "missing ASDF_INSTALL_PATH"
[ -n "${ASDF_DOWNLOAD_PATH:-}" ] || fail "missing ASDF_DOWNLOAD_PATH"

[ "$ASDF_INSTALL_TYPE" = "version" ] || fail "only release installs are supported (got install type '$ASDF_INSTALL_TYPE')"

install_path="$ASDF_INSTALL_PATH"
download_path="$ASDF_DOWNLOAD_PATH"
bin_path="${install_path}/bin"

[ -d "${download_path}/dafny" ] || fail "expected ${download_path}/dafny to exist; did bin/download run?"

mkdir -p "$bin_path"
cp -r "${download_path}/dafny/." "$bin_path/" || fail "could not copy dafny files into place"

chmod +x "${bin_path}/dafny" 2>/dev/null || true
chmod +x "${bin_path}/DafnyServer" 2>/dev/null || true
chmod +x "${bin_path}"/z3/bin/z3-* 2>/dev/null || true

[ -x "${bin_path}/dafny" ] || fail "expected executable ${bin_path}/dafny not found after install"

echo "asdf-dafny: installed dafny $ASDF_INSTALL_VERSION"
